rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 教材マスター・共通システム設定・保護者管理設定
    match /system/{document=**} {
      allow read, write: if true;
    }

    // ユーザー基本情報（ユーザー一覧・ポイント表示・更新）
    match /users/{userId} {
      allow read, write: if true;

      // ユーザーのセッション履歴・進捗ログ
      match /{subCollection}/{docId} {
        allow read, write: if true;
      }
    }

    // 外部学習申請（子ども申請・親承認）
    match /externalRequests/{requestId} {
      allow read, write: if true;
    }

    // その他のコレクションは拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
